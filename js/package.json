{
  "name": "@spectrl-ms/spectrl",
  "version": "1.1.0",
  "description": "Inline spectrum URL encoder, embeds peak arrays and modeled metadata in a compact, URL-safe token. JavaScript/TypeScript implementation of the spectrl.v1 format.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./zstd": {
      "types": "./dist/zstd.d.ts",
      "import": "./dist/zstd.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/clean_dist.mjs && tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "fuzz": "node --import tsx scripts/fuzz_decode.ts",
    "gen-vectors": "node --import tsx scripts/gen_reverse_vectors.ts",
    "prepublishOnly": "npm run build && npm test",
    "prepack": "npm run build"
  },
  "keywords": [
    "mass-spectrometry",
    "proteomics",
    "mzml",
    "proforma",
    "spectrum-sharing",
    "spectrum"
  ],
  "author": "Patrick Tyler Garrett <pgarrett@scripps.edu>",
  "contributors": [
    "John R. Yates III <jyates@scripps.edu>"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pgarrett-scripps/spectrl.git",
    "directory": "js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@cloudpss/zstd": "^0.3.23",
    "cbor-x": "^1.6.4",
    "pako": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pako": "^2.0.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "sideEffects": false,
  "homepage": "https://github.com/pgarrett-scripps/spectrl/tree/main/js#readme",
  "bugs": {
    "url": "https://github.com/pgarrett-scripps/spectrl/issues"
  }
}
